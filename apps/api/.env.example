# Copy to .env for local development. Never commit the real .env file.
# In staging/production these are injected by the cloud secrets manager /
# container orchestrator, not read from a file on disk.

NODE_ENV=development
PORT=3000

# Postgres connection string (see prisma/schema.prisma for the data model).
DATABASE_URL=postgresql://user:password@localhost:5432/profitflow?schema=public

# --- Elogistia delivery integration (platform-level config only) ---
# Per-tenant Elogistia API keys are NEVER stored here - each seller's key is
# entered via POST /api/delivery/connections, then encrypted and stored per
# tenant in the delivery_provider_connections table.
DELIVERY_API_URL=https://api.elogistia.com
DELIVERY_API_TIMEOUT_MS=10000
DELIVERY_RATE_LIMIT_PER_MINUTE=100
DELIVERY_SYNC_CRON=*/15 * * * *

# Master key used to envelope-encrypt tenant delivery-provider credentials
# at rest (AES-256-GCM, 32 random bytes, base64-encoded). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this must come from a real KMS-managed key, not a static
# value in an env file - see docs/integrations/elogistia-api.md.
DELIVERY_CREDENTIALS_ENCRYPTION_KEY=

# Secret used to sign/verify tenant session JWTs (the ONLY credential the
# frontend ever sends to this service).
JWT_SECRET=

# Separate shared secret guarding internal-only routes (e.g. manually
# triggering the sync job) - distinct from tenant JWTs on purpose.
INTERNAL_API_TOKEN=

# --- Meta Ads integration (platform-level config only) ---
# Per-tenant Meta access tokens are NEVER stored here - each seller
# authenticates via OAuth (GET /api/meta-ads/oauth/start), and the resulting
# long-lived token is encrypted and stored per tenant in the
# meta_ad_account_connections table.
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v19.0
META_ADS_RATE_LIMIT_PER_MINUTE=200
META_ADS_API_TIMEOUT_MS=15000
META_ADS_SYNC_CRON=0 * * * *

# From your Meta developer app (https://developers.facebook.com/apps). The
# app id is not secret - it appears in the OAuth redirect URL the browser is
# sent to - but the app SECRET must never leave the backend or be sent to
# the frontend; it is only ever used server-side during the OAuth token
# exchange.
META_APP_ID=
META_APP_SECRET=
# Must exactly match a "Valid OAuth Redirect URI" configured on the Meta app,
# and point at this backend's callback route, e.g.
# https://api.yourapp.com/api/meta-ads/oauth/callback
META_OAUTH_REDIRECT_URI=

# Signs the OAuth `state` param so the callback (a plain browser redirect
# with no Authorization header) can recover which tenant started the flow.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_OAUTH_STATE_SECRET=

# --- Cross-origin access ---
# Comma-separated list of browser origins allowed to call this API
# (your frontend's URL(s), e.g. https://app.yourdomain.com). Leave empty to
# block ALL cross-origin browser access - the safe default. This never
# affects server-to-server calls (CORS is a browser-only restriction).
CORS_ALLOWED_ORIGINS=

# --- Distributed rate limiting (required once this runs as more than one
# instance - e.g. on Vercel, where every invocation is a separate process) ---
# Free tier at https://upstash.com - REST API, no persistent connection
# needed, so it works from a serverless function. Leave both unset for local
# single-process development; the app falls back to an in-memory limiter
# and logs a warning if it detects it's running serverless without these set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Demo authentication (off by default) ---
# Enables POST /api/auth/demo-token, which mints a valid tenant session for
# ANY tenantId string with no password - there is no real login/signup
# system yet (see ARCHITECTURE.md's Auth/Tenancy module, still to be built).
# It requires INTERNAL_API_TOKEN either way, but that only limits WHO can
# call it, not WHICH tenant they can mint a session for. Never set this to
# true on a deployment holding real seller data - see docs/security-review.md.
ENABLE_DEMO_AUTH=false

# --- Local/manual testing convenience ONLY - not read by the running app ---
# The real Elogistia key and Meta access token are never platform-level env
# vars: each seller's own key/token is supplied through the app itself
# (POST /api/delivery/connections, and the Meta OAuth flow respectively),
# then encrypted and stored per tenant - see docs/security-review.md. These
# two are here only so a throwaway local script (e.g. hitting the Elogistia
# or Graph API directly to inspect a raw response) has somewhere standard to
# read a test credential from; delete them if you don't have such a script.
DELIVERY_API_KEY=
META_ACCESS_TOKEN=
