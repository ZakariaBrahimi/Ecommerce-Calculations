# Copy to .env.local for local development. Never commit the real file.
#
# Every variable below is read SERVER-SIDE only (Server Components, Route
# Handlers) - none is prefixed NEXT_PUBLIC_, so none of it is ever bundled
# into client-side JavaScript or visible to the browser. See
# src/lib/backendClient.ts and docs/deployment-vercel-frontend.md.

# The backend's real URL (its Vercel deployment, or a custom domain in front
# of it). Never exposed to the browser - all data fetches are proxied
# server-side through this Next.js app's own Route Handlers/Server
# Components, so the browser only ever talks to this app's own origin.
BACKEND_API_URL=https://your-backend.vercel.app

# Must match the backend's INTERNAL_API_TOKEN exactly - used only by
# src/app/api/session/route.ts to mint a demo tenant session server-side.
# The backend rejects this call entirely unless it ALSO has
# ENABLE_DEMO_AUTH=true set - see apps/api/.env.example.
INTERNAL_API_TOKEN=
