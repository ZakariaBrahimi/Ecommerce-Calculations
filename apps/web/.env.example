# Copy to .env.local for local development. Never commit the real file.
#
# Every variable below is read SERVER-SIDE only (Server Components, Route
# Handlers) - none is prefixed NEXT_PUBLIC_, so none of it is ever bundled
# into client-side JavaScript or visible to the browser. See
# src/lib/backendClient.ts and docs/deployment-vercel-frontend.md.

# The backend's real URL (its Vercel deployment, or a custom domain in front
# of it). Never exposed to the browser - all data fetches are proxied
# server-side through this Next.js app's own Route Handlers/Server
# Components, so the browser only ever talks to this app's own origin.
BACKEND_API_URL=https://your-backend.vercel.app

# Must match the backend's INTERNAL_API_TOKEN exactly - used only by
# src/app/api/session/route.ts to mint a demo tenant session server-side.
# The backend rejects this call entirely unless it ALSO has
# ENABLE_DEMO_AUTH=true set - see apps/api/.env.example.
INTERNAL_API_TOKEN=

# --- Stateless serverless integration (src/app/api/elogistia/*, src/app/api/meta/*, /live) ---
# A separate, no-database integration: every request here calls Elogistia/Meta
# directly from a Vercel Function and returns live data, with nothing persisted
# in between - see docs/deployment-vercel-serverless.md. Unrelated to
# BACKEND_API_URL/INTERNAL_API_TOKEN above (that's apps/api's DB-backed,
# multi-tenant OAuth integration) - the two coexist without overlapping.

# Elogistia: a single platform-level API key (this integration is
# single-account, not multi-tenant) - generate from the Elogistia dashboard.
ELOGISTIA_API_KEY=
ELOGISTIA_API_URL=https://api.elogistia.com
ELOGISTIA_API_TIMEOUT_MS=10000

# Meta: a single long-lived access token instead of the OAuth dialog/callback
# flow (there's nowhere to store a token between requests). Generate one via
# Graph API Explorer (https://developers.facebook.com/tools/explorer) with the
# ads_read permission, then exchange it for a long-lived token (~60 day
# expiry, must be refreshed manually before it expires):
#   GET https://graph.facebook.com/v19.0/oauth/access_token
#     ?grant_type=fb_exchange_token&client_id=<app id>&client_secret=<app secret>
#     &fb_exchange_token=<short-lived token>
META_ACCESS_TOKEN=
# The ad account to read, including the "act_" prefix, e.g. act_123456789.
META_AD_ACCOUNT_ID=
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v19.0
META_API_TIMEOUT_MS=15000
