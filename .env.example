# ProfitFlow AI — environment variables, project overview.
#
# The runnable backend lives in apps/api/, so its own .env.example there is
# the authoritative, complete list (DB, both integrations, encryption keys,
# CORS, rate limiting) with explanations for each. Copy THAT one to
# apps/api/.env for local development:
#
#   cp apps/api/.env.example apps/api/.env
#
# This root file exists to answer, at a glance, "where do the three secrets
# this project must never expose live?" - see docs/security-review.md for
# the full review and docs/deployment-vercel.md for how they're managed in
# deployment. Never commit a real .env file anywhere in this repo (already
# enforced by .gitignore).

# Database password lives inside this connection string - never logged,
# never returned by any API response.
DATABASE_URL=

# NOT a real platform variable in this system: each seller's own Elogistia
# API key is supplied through the app (POST /api/delivery/connections) and
# stored encrypted per tenant, not as a shared env var. Present here only
# for a local throwaway test script; the running server never reads it.
# See apps/api/.env.example for the real per-integration config.
DELIVERY_API_KEY=

# NOT a real platform variable either, for the same reason: each seller
# authenticates via Meta's own OAuth flow (GET /api/meta-ads/oauth/start),
# and the resulting long-lived token is stored encrypted per tenant, never
# as a shared env var. Present here only for a local throwaway test script.
META_ACCESS_TOKEN=
