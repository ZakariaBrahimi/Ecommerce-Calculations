# Copy to .env for local development. Never commit the real .env file.
# Production values live in the cloud secrets manager, not here — see docs/integrations/elogistia-api.md.

# --- Elogistia delivery integration (platform-level config only) ---
# Per-tenant Elogistia API keys are NOT stored here — they live encrypted
# per seller in the delivery_provider_connections table.
DELIVERY_API_URL=https://api.elogistia.com
DELIVERY_API_TIMEOUT_MS=10000
DELIVERY_RATE_LIMIT_PER_MINUTE=100

# KMS key ID used to envelope-encrypt tenant delivery-provider credentials
# at rest (the key material itself stays in KMS, never in env vars).
DELIVERY_CREDENTIALS_ENCRYPTION_KEY_ID=
